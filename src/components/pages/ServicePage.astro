---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CtaBand from '../CtaBand.astro';
import { photos, alts } from '../../data/photos.js';
import { t, route, serviceList, alternatesFor, durLabel } from '../../i18n/content.js';
import { coreGraph, breadcrumbs, serviceSchema, faqPage } from '../../lib/schema.js';
interface Props { lang: 'en' | 'es' | 'it'; serviceKey: string; }
const { lang, serviceKey } = Astro.props;
const C = t[lang].common;
const N = t[lang].nav;
const all = serviceList(lang);
const s = all.find((x) => x.key === serviceKey)!;
const others = all.filter((x) => x.key !== serviceKey);
const crumbs = [
  { name: N.home, href: route('home', lang) },
  { name: t[lang].servicesHub.h1, href: route('services', lang) },
  { name: s.title, href: s.href },
];
const schema = [...coreGraph(lang), breadcrumbs(crumbs), serviceSchema(s, lang), faqPage(s.faqs)];
---
<Base title={s.metaTitle} description={s.metaDesc} lang={lang} alternates={alternatesFor('service', serviceKey)} schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="hero-grid">
        <div class="inner">
          <h1>{s.title}</h1>
          {s.intro.map((p, i) => <p class={i === 0 ? 'lead' : 'muted'}>{p}</p>)}
          <div class="price-card">
            <fieldset class="durations">
              <legend>{C.chooseLength}</legend>
              <div class="seg">
                {s.durations.map((d) => (
                  <>
                    <input type="radio" name="dur" id={`d${d}`} value={d} checked={d === s.defaultDuration} />
                    <label for={`d${d}`}>{durLabel(d, lang)}</label>
                  </>
                ))}
              </div>
              <div class="prices">
                {s.durations.map((d) => (
                  <p class={`pr pr-${d}`}><span class="big">£{s.rates[d]}</span> <span class="unit">{C.perLesson} · {durLabel(d, lang)}</span></p>
                ))}
              </div>
            </fieldset>
            <ul>
              <li><span class="dot dot--c"></span>{C.trialFree}</li>
              <li><span class="dot"></span>{C.perLessonPack}</li>
              {s.key === 'inperson' && <li><span class="dot"></span>{C.minNote}</li>}
            </ul>
            <a class="btn btn--primary" href={route('trial', lang)}>{C.bookTrial}</a>
          </div>
        </div>
        <div class="photo">
          <Picture src={photos[s.photo]} alt={alts[s.photo]} widths={[480, 720, 960]} sizes="(min-width: 900px) 480px, 92vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div data-reveal>
        <h2 class="h">{C.whoFor}</h2>
        <ul class="ticks">{s.forWho.map((w) => <li>{w}</li>)}</ul>
      </div>
      <div data-reveal>
        <h2 class="h">{C.included}</h2>
        <ul class="ticks ticks--sun">{s.includes.map((w) => <li>{w}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section section--sky">
    <div class="wrap">
      <h2 class="h">{C.lessonLooks}</h2>
      <ol class="steps">
        {s.lesson.map(([h, p], i) => <li data-reveal><span class="n">{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <h2 class="h">{C.faq}</h2>
      <div class="faq">{s.faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>

  <section class="section section--sun">
    <div class="wrap">
      <h2 class="h">{C.other}</h2>
      <div class="others">
        {others.map((o) => (
          <a class="other" href={o.href}>
            <Picture src={photos[o.photo]} alt="" widths={[240, 400]} sizes="(min-width: 900px) 260px, 45vw" formats={['avif', 'webp']} />
            <span class="ot">{o.title}</span>
            <span class="op">{C.from} {o.price}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
<style>
  .hero-grid { display: grid; gap: 28px; margin-top: 18px; }
  .inner { display: grid; gap: 14px; }
  .photo { border-radius: 999px 999px 28px 28px; overflow: hidden; border: 8px solid var(--white); box-shadow: var(--shadow); max-width: 480px; }
  .photo :global(img) { width: 100%; aspect-ratio: 4 / 4.2; object-fit: cover; }
  .price-card { margin-top: 8px; background: var(--white); border-radius: var(--radius); padding: 20px; display: grid; gap: 12px; justify-items: start; box-shadow: var(--shadow); }
  .big { font-weight: 800; font-size: 2.2rem; color: var(--teal); }
  .unit { color: var(--ink-soft); }
  .durations { border: 0; padding: 0; margin: 0; display: grid; gap: 12px; width: 100%; }
  .durations legend { font-weight: 700; font-size: var(--step--1); margin-bottom: 10px; }
  .seg { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 4px; background: var(--sky); padding: 5px; border-radius: 16px; width: 100%; max-width: 420px; }
  .seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .seg label { text-align: center; white-space: nowrap; padding: 10px 4px; border-radius: 12px; font-weight: 700; font-size: .88rem; cursor: pointer; color: var(--ink-soft); transition: background .15s, color .15s; }
  .seg input:checked + label { background: var(--teal); color: #fff; }
  .seg input:focus-visible + label { outline: 3px solid var(--sun); }
  .pr { display: none; }
  .durations:has(#d30:checked) .pr-30, .durations:has(#d45:checked) .pr-45, .durations:has(#d60:checked) .pr-60, .durations:has(#d90:checked) .pr-90 { display: block; }
  .price-card li { display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--sun); }
  .dot--c { background: var(--coral); }
  .price-card ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: var(--step--1); font-weight: 600; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.2fr 1fr; align-items: center; gap: 64px; } .photo { justify-self: end; } }

  .h { font-size: var(--step-2); margin-bottom: 18px; }
  .two { display: grid; gap: 40px; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .ticks { list-style: none; padding: 0; display: grid; gap: 10px; }
  .ticks li { position: relative; padding: 14px 16px 14px 52px; background: var(--sky); border-radius: 16px; font-weight: 600; }
  .ticks li::before { content: '✓'; position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 26px; height: 26px; border-radius: 50%; background: var(--teal); color: #fff; display: grid; place-items: center; font-size: .85rem; }
  .ticks--sun li { background: var(--sun-soft); }
  .ticks--sun li::before { background: var(--coral); }

  .steps { list-style: none; padding: 0; display: grid; gap: 14px; }
  .steps li { position: relative; background: var(--white); border-radius: var(--radius); padding: 20px 20px 20px 82px; display: grid; gap: 4px; }
  .steps p { color: var(--ink-soft); font-size: var(--step--1); }
  .n { position: absolute; left: 18px; top: 18px; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: var(--sun); font-weight: 800; font-size: 1.2rem; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); } .steps li { padding: 84px 22px 24px; } .n { left: 22px; top: 22px; } }

  .faq-wrap { display: grid; gap: 8px; }
  .faq { display: grid; gap: 10px; }
  .faq details { border: 2px solid var(--line); border-radius: 18px; padding: 0 20px; }
  .faq details[open] { border-color: var(--sun); }
  .faq summary { list-style: none; cursor: pointer; padding: 18px 36px 18px 0; font-weight: 700; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 28px; height: 28px; border-radius: 50%; background: var(--sun-soft); display: grid; place-items: center; font-weight: 700; transition: transform .2s; }
  .faq details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq details p { padding-bottom: 18px; color: var(--ink-soft); }
  @media (min-width: 900px) { .faq-wrap { grid-template-columns: 1fr 1.6fr; gap: 48px; align-items: start; } }

  .others { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  @media (min-width: 900px) { .others { grid-template-columns: repeat(4, 1fr); } }
  .other { display: grid; gap: 4px; background: var(--white); border-radius: 18px; overflow: hidden; text-decoration: none; color: var(--ink); padding-bottom: 14px; transition: transform .2s; }
  .other:hover { transform: translateY(-3px); color: var(--ink); }
  .other :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; margin-bottom: 8px; }
  .ot { font-weight: 800; padding: 0 14px; line-height: 1.25; }
  .op { padding: 0 14px; font-size: var(--step--1); color: var(--ink-soft); }
</style>
