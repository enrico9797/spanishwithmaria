---
// Logo: a teal speech bubble with "ñ" + friendly wordmark.
interface Props { dark?: boolean; }
const { dark = false } = Astro.props;
---
<span class:list={['logo', { dark }]}>
  <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
    <path d="M10 4h28a8 8 0 0 1 8 8v18a8 8 0 0 1-8 8H20l-9 7v-7h-1a8 8 0 0 1-8-8V12a8 8 0 0 1 8-8Z" />
    <text x="24" y="30" text-anchor="middle">ñ</text>
  </svg>
  <span class="word">Spanish with <span>María</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 9px; }
  .mark { width: 40px; height: 40px; }
  .mark path { fill: var(--teal); }
  .mark text { fill: #fff; font: 800 24px/1 var(--sans); }
  .word { font: 800 1.2rem/1 var(--sans); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }
  .word span { color: var(--teal); }
  .dark .mark path { fill: var(--sun); }
  .dark .mark text { fill: var(--teal-dark); }
  .dark .word { color: #fff; }
  .dark .word span { color: var(--sun); }
</style>
