---
import { site } from '../data/site.js';
---
<div class="mobile-bar" role="complementary" aria-label="Quick contact">
  <a class="btn btn--primary" href="/free-trial/">Book free trial</a>
  <a class="wa" href={site.whatsapp} aria-label="Message María on WhatsApp" rel="noopener">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
    <span>WhatsApp</span>
  </a>
</div>
<style>
  .mobile-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    display: grid; grid-template-columns: 1fr auto; gap: 10px;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: rgba(255,255,255,.96); backdrop-filter: blur(10px);
    border-top: 1px solid var(--mist-2);
  }
  .mobile-bar .btn { box-shadow: none; }
  .wa { display: inline-flex; align-items: center; gap: 8px; padding: 0 18px; min-height: 52px; border-radius: 999px; background: #1f8f4e; color: #fff; text-decoration: none; font-weight: 600; }
  .wa:hover { color: #fff; background: #187341; }
  @media (min-width: 900px) { .mobile-bar { display: none; } }
</style>
