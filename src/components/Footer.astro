---
import { site, services } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <p class="name">Spanish <em>with</em> María</p>
      <p>Friendly one-to-one Spanish lessons, online worldwide and in person in London.</p>
      <p class="contact">
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={site.whatsapp} rel="noopener">WhatsApp {site.phone}</a>
      </p>
    </div>
    <nav aria-label="Lessons">
      <p class="h">Lessons</p>
      <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
    </nav>
    <nav aria-label="More">
      <p class="h">More</p>
      <ul>
        <li><a href="/about/">About María</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/reviews/write/">Leave a review</a></li>
        <li><a href="/free-trial/">Free trial lesson</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>
    <nav aria-label="Languages">
      <p class="h">Languages</p>
      <ul>
        <li><a href="/" hreflang="en">English</a></li>
        <li><a href="/es/" hreflang="es" lang="es">Español</a></li>
        <li><a href="/it/" hreflang="it" lang="it">Italiano</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap small">© {year} Spanish with María · {site.teacher}</div>
</footer>
<style>
  .footer { background: var(--teal-deep); color: #cfe3e6; padding: 64px 0 28px; }
  .footer a { color: #fff; text-decoration: none; }
  .footer a:hover { text-decoration: underline; color: #fff; }
  .grid { display: grid; gap: 36px; grid-template-columns: 1fr 1fr; }
  .brand { grid-column: 1 / -1; display: grid; gap: 12px; }
  .name { font: 600 1.6rem/1 var(--serif); color: #fff; font-variation-settings: 'SOFT' 100; }
  .name em { color: var(--saffron); font-weight: 400; }
  .h { font-weight: 700; color: #fff; margin-bottom: 10px; }
  ul { list-style: none; padding: 0; display: grid; gap: 8px; }
  .small { margin-top: 48px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.12); font-size: var(--step--1); }
  @media (min-width: 900px) { .grid { grid-template-columns: 2fr 1.3fr 1fr 1fr; } .brand { grid-column: auto; } }
</style>
