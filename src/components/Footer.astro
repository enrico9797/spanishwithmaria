---
import { site } from '../data/site.js';
import { t, route, serviceList } from '../i18n/content.js';
import Logo from './Logo.astro';
interface Props { lang: 'en' | 'es' | 'it'; }
const { lang } = Astro.props;
const F = t[lang].footer;
const N = t[lang].nav;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <Logo dark />
      <p>{F.tagline}</p>
      <p class="contact">
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={site.whatsapp} rel="noopener">WhatsApp {site.phone}</a>
      </p>
    </div>
    <nav aria-label={F.lessons}>
      <p class="h">{F.lessons}</p>
      <ul>{serviceList(lang).map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul>
    </nav>
    <nav aria-label={F.more}>
      <p class="h">{F.more}</p>
      <ul>
        <li><a href={route('about', lang)}>{N.about}</a></li>
        <li><a href={route('reviews', lang)}>{N.reviews}</a></li>
        <li><a href={route('reviewsWrite', lang)}>{F.leave}</a></li>
        <li><a href={route('trial', lang)}>{N.trial}</a></li>
        <li><a href="/privacy/">{F.privacy}</a></li>
      </ul>
    </nav>
    <nav aria-label={F.languages}>
      <p class="h">{F.languages}</p>
      <ul>
        <li><a href="/" hreflang="en" lang="en">English</a></li>
        <li><a href="/es/" hreflang="es" lang="es">Español</a></li>
        <li><a href="/it/" hreflang="it" lang="it">Italiano</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap small">© {year} Spanish with María · {site.teacher}</div>
</footer>
<style>
  .footer { background: var(--teal-dark); color: #d4e7ea; padding: 64px 0 28px; }
  .footer a { color: #fff; text-decoration: none; }
  .footer a:hover { text-decoration: underline; color: #fff; }
  .grid { display: grid; gap: 36px; grid-template-columns: 1fr 1fr; }
  .brand { grid-column: 1 / -1; display: grid; gap: 12px; }
  .h { font-weight: 700; color: #fff; margin-bottom: 10px; }
  ul { list-style: none; padding: 0; display: grid; gap: 8px; }
  .small { margin-top: 48px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.12); font-size: var(--step--1); }
  @media (min-width: 900px) { .grid { grid-template-columns: 2fr 1.3fr 1fr 1fr; } .brand { grid-column: auto; } }
</style>
