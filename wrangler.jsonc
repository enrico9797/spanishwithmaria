{
  "name": "spanishwithmaria",
  "compatibility_date": "2026-09-01",
  // Build the Astro site before every deploy (Cloudflare's build command is empty)
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
